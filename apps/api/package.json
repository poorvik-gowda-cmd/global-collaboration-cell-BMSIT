{
  "name": "@gcc-portal/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env development",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:types": "wrangler types --env development",
    "clean": "rimraf dist .wrangler"
  },
  "dependencies": {
    "@gcc-portal/contracts": "workspace:*",
    "@gcc-portal/auth": "workspace:*",
    "@gcc-portal/database": "workspace:*",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "eslint": "^9.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.19.0"
  }
}
